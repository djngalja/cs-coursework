log_file() {
    MY_PATH="../02/file_generator.log"
    for log in $(cat "$MY_PATH" | awk 'NF == 3 {print $1}')
    do
        if [[ -d "../02/$log" ]]
        then
            rm -r "../02/$log"
        fi
    done
}

validate_date() {
    if [[ ! "$1" =~ ^([0-9]{4})-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])\ ([01][0-9]|2[0-3]):([0-5][0-9])$ ]]
    then
        echo "[Error] Wrong format: $1 must be YYYY-MM-DD HH:MM"
        valid_dates=-1
    elif ! date -d "$1" >/dev/null 2>&1
    then 
        echo "[Error] Invalid date: $1 is not a valid date"
        valid_dates=-1
    fi
}

date_time() {
    read -p "Enter start date and time in the following format: YYYY-MM-DD HH:MM " start
    read -p "Enter end date and time in the following format: YYYY-MM-DD HH:MM " end
    valid_dates=0
    validate_date "$start"
    validate_date "$end"
    if [[ valid_dates -eq 0 ]]
    then
        find "$INIT_DIR" -depth -type d -newermt "$start" ! -newermt "$end" -regextype posix-extended -regex '.*/[A-Za-z]+_[0-9]{6}' -exec rm -r {} \;
    fi
}

mask() {
    find "$INIT_DIR" -depth -type d -regextype posix-extended -regex '.*/[A-Za-z]+_[0-9]{6}' -exec rm -r {} \;
}

sys_clean() {
    case $1 in
    1) log_file ;;
    2) date_time ;;
    *) mask
    esac
}