methods=("GET" "POST" "PUT" "PATCH" "DELETE")
urls=(
    "/index.html"
    "/stuff.html"
    "/info.html"
    "/contact.html"
    "/map.html"
)
status_codes=(
    #Успешные ответы
    200 #(OK) Запрос успешно выполнен
    201 #(Created) Запрос выполнен успешно и в результате был создан новый ресурс
    #Ошибки клиента
    400 #(Bad Request) Сервер не может обрабатывать запрос из-за ошибки клиента
    401 #(Unauthorized) Клиент должен аутентифицировать себя, чтобы получить запрошенный ответ
    403 #(Forbidden) Клиент не имеет прав доступа к контенту
    404 #(Not Found) Сервер не может найти запрошенный ресурс
    #Ошибки сервера
    500 #(Internal Server Error) На сервере произошла ошибка, в результате которой он не может успешно обработать запрос
    501 #(Not Implemented) Метод запроса не поддерживается сервером
    502 #(Bad Gateway) В процессе обработки запроса сервер, выступающий в качестве шлюза, получил недопустимый ответ от целевого сервера
    503 #(Service Unavailable) Сервер не готов обработать запрос в данный момент
)
